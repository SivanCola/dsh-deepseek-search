{
  "name": "@sivancola/dsh-deepseek-search",
  "version": "0.3.0",
  "description": "DeepSeek Search for DeepSeek Harness: a left-sidebar search panel plus a deepseek_search tool for every model, backed by the standalone DeepSeek Search API and its own API key.",
  "author": "SivanCola (https://github.com/SivanCola)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SivanCola/dsh-deepseek-search.git"
  },
  "homepage": "https://github.com/SivanCola/dsh-deepseek-search",
  "bugs": {
    "url": "https://github.com/SivanCola/dsh-deepseek-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "web-search",
    "cordis",
    "ai-agent"
  ],
  "type": "module",
  "icon": "icon.svg",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "deepseek-api.js",
    "official-key.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
